/workspace-chirho/art-chirho/remote-archive-chirho/

# Whole-canon pinned inputs and generated source-bound reports.
/data-chirho/bible-chirho/
# Deterministic reusable-library shards retain their manifest-bound bytes.
/data-chirho/media-library-chirho/
/workspace-chirho/whole-bible-chirho/*.json

